    <string name="delete_permanent_dialog_title">Delete Permanently</string>
    <string name="delete_permanent_dialog_desc">This action removes the call record from your history.\n\nSince this number is not added to your contacts or whitelist, future incoming calls from this number will continue to be blocked.</string>
    <string name="delete_permanent_dialog_confirm">Delete</string>
