    <!-- Google Play Compliance & Prominent Disclosures -->
    <string name="disclosure_title">Privacy &amp; Data Safety Disclosure</string>
    <string name="disclosure_contacts_title">Contacts Access</string>
    <string name="disclosure_contacts_desc">Blocky requires access to your Contacts strictly to verify whether incoming callers are saved in your phonebook. All contact information is processed 100% locally on your device in real-time. Blocky NEVER collects, uploads, sells, or shares your personal contacts with external servers or third parties.</string>
    <string name="disclosure_notifications_title">Notifications</string>
    <string name="disclosure_notifications_desc">Blocky uses notifications to show an ongoing status indicator that call protection is active and alert you when an unknown call is screened.</string>
    <string name="disclosure_call_screening_title">Call Screening Service</string>
    <string name="disclosure_call_screening_desc">Blocky operates as a Call Screening Service to inspect incoming call numbers and silently block non-whitelisted spam or unknown callers before your phone rings.</string>
    <string name="disclosure_accept_btn">I Agree &amp; Continue</string>
    <string name="disclosure_decline_btn">Not Now</string>
    <string name="privacy_policy_title">Privacy Policy &amp; Data Safety</string>
    <string name="privacy_policy_btn">Privacy Policy</string>
    <string name="privacy_policy_content">Blocky is committed to protecting your privacy.\n\n1. On-Device Processing: All screening, whitelist checking, and contact lookups occur exclusively on your local device.\n\n2. No Data Collection: Blocky does NOT collect, store on remote servers, or transmit your contact list, call history, or personal identifiers.\n\n3. Permissions Used:\n• Contacts (READ_CONTACTS): To avoid blocking calls from your known contacts.\n• Notifications (POST_NOTIFICATIONS): To display active protection status.\n• Call Screening Role: To allow the Android Telecom system to pass incoming call events to Blocky for local filtering.\n\n4. Third Parties: No user data is shared with or sold to third parties or advertising networks.</string>
    <string name="close_btn">Close</string>
