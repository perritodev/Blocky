    <!-- Google Play Compliance & Prominent Disclosures -->
    <string name="disclosure_title">Divulgación de Privacidad y Seguridad</string>
    <string name="disclosure_contacts_title">Acceso a Contactos</string>
    <string name="disclosure_contacts_desc">Blocky requiere acceso a tus Contactos estrictamente para comprobar si las llamadas entrantes provienen de personas guardadas en tu agenda. Toda la información se procesa 100% de forma local en tu dispositivo. Blocky NUNCA recopila, sube a servidores, vende ni comparte tus contactos personales con terceros.</string>
    <string name="disclosure_notifications_title">Notificaciones</string>
    <string name="disclosure_notifications_desc">Blocky utiliza notificaciones para mostrarte un indicador de estado continuo de que la protección está activa y avisarte cuando se filtre una llamada desconocida.</string>
    <string name="disclosure_call_screening_title">Servicio de Filtrado de Llamadas</string>
    <string name="disclosure_call_screening_desc">Blocky opera como Servicio de Filtrado de Llamadas para inspeccionar números entrantes y bloquear silenciosamente llamadas no deseadas o números desconocidos antes de que suene tu teléfono.</string>
    <string name="disclosure_accept_btn">Acepto y Continuar</string>
    <string name="disclosure_decline_btn">Ahora No</string>
    <string name="privacy_policy_title">Política de Privacidad y Seguridad</string>
    <string name="privacy_policy_btn">Política de Privacidad</string>
    <string name="privacy_policy_content">Blocky está comprometido con la protección de tu privacidad.\n\n1. Procesamiento en el Dispositivo: Todo el filtrado, verificación de lista blanca y consulta de contactos se realiza exclusivamente de forma local.\n\n2. Sin Recopilación de Datos: Blocky NO recopila, almacena en servidores remotos ni transmite tu lista de contactos, historial ni datos personales.\n\n3. Permisos Utilizados:\n• Contactos (READ_CONTACTS): Para evitar bloquear llamadas de contactos conocidos.\n• Notificaciones (POST_NOTIFICATIONS): Para mostrar el estado de protección activa.\n• Rol de Filtrado de Llamadas: Para permitir que el sistema Android transmita eventos de llamadas entrantes a Blocky para su filtrado local.\n\n4. Terceros: Ningún dato del usuario se comparte ni vende a terceros o redes publicitarias.</string>
    <string name="close_btn">Cerrar</string>
    <string name="cancel_btn">Cancelar</string>
    <string name="delete_permanent_dialog_title">Eliminar Permanentemente</string>
    <string name="delete_permanent_dialog_desc">Esta acción elimina el registro de llamada de tu historial.\n\nComo este número no está en tus contactos ni en la lista blanca, las futuras llamadas de este número continuarán siendo bloqueadas.</string>
    <string name="delete_permanent_dialog_confirm">Eliminar</string>
    <string name="unblock_all_dialog_title">¿Desbloquear todos los números?</string>
    <string name="unblock_all_dialog_desc">Esto desbloqueará cada número telefónico en tu lista de bloqueados y permitirá futuras llamadas de ellos.</string>
    <string name="unblock_all_dialog_confirm">Desbloquear todos</string>
    <string name="thank_you_message">¡Gracias por usar Blocky, espero que te ayude! =)</string>
